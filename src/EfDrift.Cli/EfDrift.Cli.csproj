<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EfDrift.Core\EfDrift.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>efdrift</ToolCommandName>
    <PackageId>EfDrift</PackageId>
    <Version>0.0.1-alpha</Version>
    <Authors>Eugene van Rooyen</Authors>
    <Description>Detects drift between an EF Core model and a live SQL Server database.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

</Project>
